# === Обязательно ===
BOT_TOKEN=123456:ABC-DEF            # @BotFather
OWNER_IDS=                           # ваш Telegram id через запятую; пусто = владелец тот, кто первым напишет /start

# === Что продаёте (идёт в промпт ИИ; можно менять командой /profile) ===
PROFILE=Студия делает: сайты и лендинги под ключ, Telegram-боты, ИИ-автоматизацию бизнеса (чат-боты, интеграции, CRM, n8n), ИИ-мультики и видеоролики. Работаем удалённо по всей России и СНГ.

# Фразы-намерения для Threads, VK и поисковиков (через запятую). Меняются в боте: /phrases_set, /phrases_gen
# SEARCH_PHRASES=нужен сайт,ищу кто сделает сайт,нужен telegram бот,ищу разработчика бота,нужна автоматизация

# === «Как человек»: источники без API ===
PROXY_URL=                           # http://user:pass@host:port — резидентный/мобильный прокси; пусто = без прокси
WORK_HOURS=8-23                      # парсим только днём по DIGEST_TZ
THREADS_WEB_ENABLED=true             # поиск Threads без логина
KWORK_ENABLED=true
KWORK_CATEGORIES=11,all              # 11 = Разработка и IT; all = все категории
KWORK_PAGES=3
WEBLANCER_ENABLED=true
FREELANCE_RU_ENABLED=true
FREELANCE_RU_QUERIES=сайт,лендинг,бот,автоматизация,нейросеть,мультик
YANDEX_WEB_ENABLED=true              # Яндекс.Карты без ключа (если задан YANDEX_GEOSEARCH_KEY — через API)
SITE_AUDIT_ENABLED=true              # проверять сайты организаций: мёртвый / без HTTPS / не мобильный → лид на редизайн
SITE_AUDIT_PER_POLL=30

# Instagram через залогиненный браузер: python -m leadhunter.browser.login instagram, затем включить
IG_WEB_ENABLED=false
IG_WEB_PER_POLL=3
BROWSER_PROFILES_DIR=data/profiles
BROWSER_HEADLESS=true

# === Telegram-чаты (через ваш аккаунт, my.telegram.org -> API development tools) ===
TG_API_ID=
TG_API_HASH=
TG_SESSION=data/userbot
TG_CHATS=                            # @chat1,@chat2 — пусто = все группы, где состоит аккаунт
TG_JOIN_CHATS=                       # @chat или ссылки t.me/+xxx — вступить при старте
TG_SEARCH_INTERVAL=600
TG_OUTREACH_LIMIT=0                  # кнопка «Отправить с аккаунта»: сообщений в день (0 = выключено). 10-20 безопасно

# === Вебхук для CRM / n8n / Make / Google Sheets: POST JSON с каждым лидом ===
WEBHOOK_URL=

# === Официальные API (необязательно — если есть, используются вместо парсинга) ===
THREADS_ACCESS_TOKEN=                # Threads Keyword Search API (threads_keyword_search)
THREADS_INTERVAL=900
IG_ACCESS_TOKEN=                     # Instagram Graph API (бизнес-аккаунт)
IG_USER_ID=
IG_HASHTAGS=нуженсайт,ищуразработчика,нуженбот,нужнаавтоматизация,заказатьсайт,ищуподрядчика
IG_INTERVAL=1800
YANDEX_GEOSEARCH_KEY=                # Geosearch API (500 запросов/сутки)
YANDEX_CITIES=Москва,Санкт-Петербург
YANDEX_QUERIES=салон красоты,стоматология,автосервис,кофейня,фитнес клуб,ремонт квартир
YANDEX_INTERVAL=21600
VK_TOKEN=                            # user-токен VK (бесплатный)
VK_INTERVAL=300

# === Биржи и вакансии ===
RSS_FEEDS=https://www.fl.ru/rss/all.xml
RSS_INTERVAL=300
HH_ENABLED=true
HH_USER_AGENT=LeadHunter/0.1 (you@example.com)   # нужна реальная почта, иначе 403
HH_QUERIES=разработка сайта,telegram бот,автоматизация нейросеть,ИИ анимация

# === Поисковики для площадок без прямого доступа (vc.ru, pikabu) ===
SERPER_API_KEY=                      # serper.dev; пусто = DuckDuckGo без ключа
WEB_SEARCH_SITES=threads.net,instagram.com,vc.ru,pikabu.ru
WEB_SEARCH_INTERVAL=1800

# === Фильтрация ===
SCORE_THRESHOLD=5
MAX_AGE_HOURS=48
DB_PATH=data/leads.db

# === ИИ-фильтр (любой OpenAI-совместимый API: OpenAI, OpenRouter, DeepSeek, локальный Ollama) ===
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_MIN_SCORE=2
LLM_MAX_PER_HOUR=300

# === Ежедневный дайджест ===
DIGEST_HOUR=9
DIGEST_TZ=Europe/Moscow
