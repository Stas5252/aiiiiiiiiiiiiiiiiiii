# Настройки LeadHunter. Скопируйте файл в .env и заполните нужное (./install.sh делает это сам).
# Правила: комментарий — только отдельной строкой НАД переменной (в одной строке со значением нельзя:
# Docker примет его за значение). Пустое значение = «не задано», бот возьмёт значение по умолчанию.
# Проверить файл, не запуская бота: python -m leadhunter.config

# === Обязательно ===
# Токен бота от @BotFather (вида 123456789:AAH…). Замените пример на свой.
BOT_TOKEN=123456:ABC-DEF
# Ваш Telegram id через запятую. Пусто = бот напечатает в лог одноразовый код,
# владельцем станет тот, кто пришлёт боту в личку /start КОД
OWNER_IDS=

# === Что продаёте (идёт в промпт ИИ; можно менять командой /profile) ===
PROFILE=Студия делает: сайты и лендинги под ключ, Telegram-боты, ИИ-автоматизацию бизнеса (чат-боты, интеграции, CRM, n8n), ИИ-мультики и видеоролики. Работаем удалённо по всей России и СНГ.

# Фразы-намерения для Threads, VK и поисковиков (через запятую). Меняются в боте: /phrases_set, /phrases_gen
# SEARCH_PHRASES=нужен сайт,ищу кто сделает сайт,нужен telegram бот,ищу разработчика бота,нужна автоматизация

# === «Как человек»: источники без API ===
# Прокси вида http://user:pass@host:port (лучше резидентный или мобильный). Пусто = без прокси
PROXY_URL=
# Парсим только днём, часы по DIGEST_TZ. Круглые сутки: 0-24
WORK_HOURS=8-23
# Поиск Threads без логина
THREADS_WEB_ENABLED=true
KWORK_ENABLED=true
# 11 = Разработка и IT; all = все категории (много мусора)
KWORK_CATEGORIES=11
KWORK_PAGES=3
# Как часто опрашивать источник, в секундах (так же у всех *_INTERVAL ниже)
KWORK_INTERVAL=600
WEBLANCER_ENABLED=true
WEBLANCER_URLS=https://www.weblancer.net/jobs/
WEBLANCER_INTERVAL=900
FREELANCE_RU_ENABLED=true
FREELANCE_RU_QUERIES=сайт,лендинг,бот,автоматизация,нейросеть,мультик
FREELANCE_RU_INTERVAL=900
# Яндекс.Карты без ключа (если задан YANDEX_GEOSEARCH_KEY — через API)
YANDEX_WEB_ENABLED=true
# Проверять сайты организаций: мёртвый / без HTTPS / не мобильный → лид на редизайн
SITE_AUDIT_ENABLED=true
SITE_AUDIT_PER_POLL=30

# Instagram через залогиненный браузер: python -m leadhunter.browser.login instagram, затем включить
IG_WEB_ENABLED=false
IG_WEB_PER_POLL=3
BROWSER_PROFILES_DIR=data/profiles
BROWSER_HEADLESS=true

# === Telegram-чаты (через ваш аккаунт, my.telegram.org -> API development tools) ===
TG_API_ID=
TG_API_HASH=
TG_SESSION=data/userbot
# @chat1,@chat2 — пусто = все группы, где состоит аккаунт
TG_CHATS=
# @chat или ссылки t.me/+xxx — вступить при старте
TG_JOIN_CHATS=
TG_SEARCH_INTERVAL=600
# Слова для поиска новых сообщений по всем чатам аккаунта
TG_SEARCH_WORDS=сайт,лендинг,бот,автоматизация,нейросеть,мультик,анимация
# Кнопка «Отправить с аккаунта»: сообщений в день (0 = выключено). 10-20 безопасно
TG_OUTREACH_LIMIT=0

# === Вебхук для CRM / n8n / Make / Google Sheets: POST JSON с каждым лидом ===
WEBHOOK_URL=

# === Рабочая группа (форум с темами) и команда ===
# Создайте группу → включите «Темы» → добавьте бота админом с правом «Управление темами» → напишите в ней /setup_group
# С этого балла лид идёт в «🔥 Горячие» со звуком
HOT_SCORE=8
# Дублировать лидов владельцу в личку, даже если есть группа
DELIVER_DM=false
# Лид не взят столько минут → пинг в «Горячие»
SLA_MINUTES=10
# SLA считаем для лидов с таким баллом и выше
SLA_MIN_SCORE=7
# Напомнить, если после «Написал» клиент молчит столько часов
FOLLOWUP_HOURS=24
# Автор в стольких чатах за час = рассылка, в игнор
SPAM_CHATS_PER_HOUR=3
# /discover: в сколько чатов вступать в день
DISCOVER_JOIN_PER_DAY=5

# === Mini App (кабинет внутри Telegram) ===
# Вариант 1 (проще всего): MINIAPP_TUNNEL=cloudflare — бот сам поднимет бесплатный туннель Cloudflare и поставит кнопку «Кабинет».
#   Адрес меняется при каждом перезапуске, для теста и старта — идеально. cloudflared уже есть в Docker-образе.
# Вариант 2: свой домен с HTTPS (Caddy / nginx + certbot / именованный Cloudflare Tunnel) → MINIAPP_URL
MINIAPP_TUNNEL=
# Например https://leads.example.com/app. Пусто и без туннеля = кабинет выключен
MINIAPP_URL=
# В Docker не меняйте: наружу проброшен именно 8080
MINIAPP_PORT=8080

# === Официальные API (необязательно — если есть, используются вместо парсинга) ===
# Threads Keyword Search API (разрешение threads_keyword_search)
THREADS_ACCESS_TOKEN=
THREADS_INTERVAL=900
# Instagram Graph API (бизнес-аккаунт)
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_HASHTAGS=нуженсайт,ищуразработчика,нуженбот,нужнаавтоматизация,заказатьсайт,ищуподрядчика
IG_INTERVAL=1800
# Яндекс Geosearch API (500 запросов в сутки)
YANDEX_GEOSEARCH_KEY=
# Города через запятую: Москва,Санкт-Петербург,Казань
YANDEX_CITIES=Москва
YANDEX_QUERIES=салон красоты,стоматология,автосервис,кофейня,фитнес клуб,ремонт квартир
YANDEX_INTERVAL=21600
# User-токен VK (бесплатный)
VK_TOKEN=
VK_INTERVAL=300

# === Биржи и вакансии ===
# Пусто = не читать RSS
RSS_FEEDS=https://www.fl.ru/rss/all.xml
RSS_INTERVAL=300
# hh.ru выключен, пока не указана настоящая почта: без неё hh отвечает ошибкой 400.
# Чтобы включить: HH_ENABLED=true и HH_USER_AGENT=LeadHunter/0.1 (вы@ваш-домен.ru)
HH_ENABLED=false
HH_USER_AGENT=
HH_QUERIES=разработка сайта,telegram бот,автоматизация нейросеть,ИИ анимация
HH_INTERVAL=900

# === Поисковики для площадок без прямого доступа (vc.ru, pikabu) ===
# Ключ serper.dev; пусто = DuckDuckGo без ключа
SERPER_API_KEY=
WEB_SEARCH_SITES=threads.net,instagram.com,vc.ru,pikabu.ru
WEB_SEARCH_INTERVAL=1800

# === Фильтрация ===
SCORE_THRESHOLD=5
MAX_AGE_HOURS=48
DB_PATH=data/leads.db

# === ИИ ===
# Вариант A (рекомендуется, один ключ на всё): Gemini — aistudio.google.com → Get API key.
#   Тексты (gemini-3.8-flash, есть бесплатный лимит), озвучка (gemini-3.8-flash-tts, бесплатно),
#   картинки (gemini-nano-banana-2.1 ≈ 0,03 $/шт, нужен биллинг), ИИ-видео (gemini-omni-1.2-flash ≈ 0,07 $/сек, нужен биллинг).
GEMINI_API_KEY=
# Пусто = gemini-3.5-flash-lite (щедрый бесплатный лимит); умнее: gemini-3.8-flash
GEMINI_MODEL=
# Пусто = gemini-nano-banana-2.1; дешевле: gemini-3.1-flash-lite-image
GEMINI_IMAGE_MODEL=
# Пусто = gemini-omni-1.2-flash
GEMINI_VIDEO_MODEL=
# Пусто = gemini-3.8-flash-tts
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=Kore
# Вариант B: любой OpenAI-совместимый API для текстов (OpenAI, OpenRouter, DeepSeek, Ollama). Если задан — тексты идут сюда, медиа — в Gemini.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_MIN_SCORE=2
LLM_MAX_PER_HOUR=300
# Медиа через OpenAI (только если нет GEMINI_API_KEY): IMAGE_MODEL=gpt-image-2.5-flare, TTS_MODEL — старые tts-1/gpt-4o-mini-tts закрываются 06.01.2027
IMAGE_MODEL=
TTS_MODEL=
TTS_VOICE=alloy

# === Ежедневный дайджест ===
# Час отправки, 0–23. Пусто = без дайджеста
DIGEST_HOUR=9
# Часовой пояс для дайджеста, рабочих часов и расписания: Europe/Moscow, Asia/Yekaterinburg, Asia/Novosibirsk…
DIGEST_TZ=Europe/Moscow

# === Контент-фабрика ===
CONTENT_DIR=data/content
# Автопилот (/autopilot on) приносит черновик в этот час, 0–23
CONTENT_HOUR=10
# Площадки. Telegram-канал и VK задаются в боте: /channel_set telegram @канал, /channel_set vk -id_группы
# VK: токен сообщества публикует только текст; для фото/видео нужен пользовательский токен с правами wall,photos,video
# Публикация в Threads вместе с THREADS_ACCESS_TOKEN (права threads_content_publish)
THREADS_USER_ID=
# Instagram: IG_ACCESS_TOKEN + IG_USER_ID выше (права instagram_content_publish) + публичный адрес Mini App для картинок
# YouTube Shorts: OAuth-клиент Google Cloud + refresh token с правом youtube.upload
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
