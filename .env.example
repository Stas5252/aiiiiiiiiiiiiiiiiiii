# === Обязательно ===
BOT_TOKEN=123456:ABC-DEF            # @BotFather
OWNER_IDS=                           # ваш Telegram id через запятую; пусто = владелец тот, кто первым напишет /start

# === Telegram-чаты (через ваш аккаунт, my.telegram.org -> API development tools) ===
TG_API_ID=
TG_API_HASH=
TG_SESSION=data/userbot
TG_CHATS=                            # @chat1,@chat2 — пусто = все группы, где состоит аккаунт
TG_SEARCH_INTERVAL=600

# === Яндекс.Карты: бизнесы без сайта (ключ Geosearch API, developer.tech.yandex.ru) ===
YANDEX_GEOSEARCH_KEY=
YANDEX_CITIES=Москва,Санкт-Петербург
YANDEX_QUERIES=салон красоты,стоматология,автосервис,кофейня,фитнес клуб,ремонт квартир
YANDEX_INTERVAL=21600

# === Биржи (RSS заказов) ===
RSS_FEEDS=https://www.fl.ru/rss/all.xml
RSS_INTERVAL=300

# === hh.ru (нужен User-Agent с реальной почтой, иначе API отвечает 403) ===
HH_ENABLED=true
HH_USER_AGENT=LeadHunter/0.1 (you@example.com)
HH_QUERIES=разработка сайта,telegram бот,автоматизация нейросеть,ИИ анимация

# === VK (user-токен с правами wall, vk.com/dev) ===
VK_TOKEN=
VK_INTERVAL=300

# === Threads / Instagram / vc.ru через поисковики ===
SERPER_API_KEY=                      # serper.dev; пусто = бесплатный DuckDuckGo (медленнее и меньше выдача)
WEB_SEARCH_SITES=threads.net,instagram.com,vc.ru,pikabu.ru
WEB_SEARCH_INTERVAL=1800

# === Общие ===
SCORE_THRESHOLD=5
DB_PATH=data/leads.db

# === ИИ-фильтр (необязательно; любой OpenAI-совместимый API) ===
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
